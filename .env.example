# Copy to .env in the project root:  cp .env.example .env
DATABASE_URL=postgresql+psycopg2://xai_user:xai_pass@localhost:5432/xai_threat
ANOMALY_MODEL=autoencoder            # autoencoder | isolation_forest
ANOMALY_ALERT_THRESHOLD=70           # anomaly score (0-100) that raises a low alert on "Benign" flows
CORS_ORIGINS=http://localhost:5173
# Flows used by "Simulate traffic". Point to your CIC-IDS2017 folder after downloading it, e.g.:
# SIMULATION_CSV=data/cicids2017
SIMULATION_CSV=data/sample_traffic.csv
